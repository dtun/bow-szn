{
  "name": "@bow-szn/pixels",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./png": "./src/png.ts"
  },
  "scripts": {
    "brand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-brand.ts",
    "icon:homescreen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/icon-homescreen.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:snapshot": "jest --selectProjects snapshot",
    "vibecheck": "npm run lint && npm run typecheck && npm run test && npm run test:snapshot"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^25.3.5",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.2"
  }
}
