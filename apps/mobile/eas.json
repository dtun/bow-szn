{
  "cli": {
    "version": ">= 16.13.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "22.23.3"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "22.23.3"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "node": "22.23.3"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "metadataPath": "./store.config.json"
      }
    }
  }
}
