{
  "expo": {
    "name": "Bow Season",
    "slug": "bow-season",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bowseason",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f1a",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.paperstreetapp.bowseason",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.game-center": true
      }
    },
    "android": {
      "package": "com.paperstreetapp.bowseason",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundImage": "./assets/brand/adaptive-background.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0f1a",
          "image": "./assets/brand/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "paperstreetappllc",
    "extra": {
      "eas": {
        "projectId": "e7663367-c007-4f5d-a3ab-0a129a9111f7"
      }
    },
    "icon": "./assets/brand/icon.png",
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e7663367-c007-4f5d-a3ab-0a129a9111f7"
    }
  }
}
