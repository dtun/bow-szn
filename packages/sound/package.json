{
  "name": "@bow-szn/sound",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./wav": "./src/wav.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:snapshot": "jest --selectProjects snapshot --passWithNoTests",
    "test:all": "jest --passWithNoTests",
    "vibecheck": "npm run lint && npm run typecheck && npm run test:all"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^25.3.5",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.2"
  }
}
