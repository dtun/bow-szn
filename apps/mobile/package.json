{
  "name": "@bow-szn/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios:submit": "eas build --platform ios --profile production --auto-submit",
    "lint": "expo lint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit ui integration",
    "test:snapshot": "jest --selectProjects snapshot --passWithNoTests",
    "test:all": "jest --passWithNoTests",
    "vibecheck": "npm run lint && npm run typecheck && npm run test:all"
  },
  "dependencies": {
    "@bow-szn/core": "*",
    "@bow-szn/pixels": "*",
    "@expo-google-fonts/press-start-2p": "^0.4.1",
    "@shopify/react-native-skia": "2.4.18",
    "expo": "~55.0.32",
    "expo-audio": "~55.0.18",
    "expo-constants": "~55.0.9",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  }
}
